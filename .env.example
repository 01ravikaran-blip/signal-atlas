# ==========================================
# SIGNAL ATLAS - ENVIRONMENT CONFIGURATION
# ==========================================

# Operating Mode
# DEMO_MODE=true runs the system using public market/RSS data, simulated platform publishing,
# and built-in local NLP engine / Ollama local LLM without requiring paid API keys.
DEMO_MODE=true

# Server & UI Ports
PORT=5050
CLIENT_PORT=3000

# Emergency Global Pause Switch (true = paused, false = active autonomous execution)
EMERGENCY_PAUSE=false

# Autonomous Execution Schedule Interval (in minutes)
PUBLISH_INTERVAL_MINUTES=5

# Content Mix Ratios (Must total 100%)
CRYPTO_DEFI_PERCENT=50
AI_WEB3_PERCENT=25
STOCKS_MACRO_PERCENT=25

# Minimum Source Confidence Threshold for Autonomous Publishing (0.0 to 1.0)
MIN_CONFIDENCE_THRESHOLD=0.70

# ------------------------------------------
# LOCAL & CLOUD AI / LLM CONFIGURATION
# ------------------------------------------
# AI Provider / LLM Provider: 'groq' (default), 'ollama', 'openai', 'gemini'
LLM_PROVIDER=groq
AI_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Ollama local settings (optional fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Legacy Cloud AI Keys (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------
# PLATFORM CREDENTIALS (Required for live publishing)
# ------------------------------------------

# 1. BLUESKY (AT Protocol)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# 2. FARCASTER (Neynar API or Warpcast Developer Account)
FARCASTER_NEYNAR_API_KEY=
FARCASTER_SIGNER_UUID=
FARCASTER_FID=

# 3. TELEGRAM BOT
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. DISCORD WEBHOOK & BOT
DISCORD_WEBHOOK_URL=
DISCORD_HANDLE=@signalatlas
DISCORD_INVITE_URL=https://discord.gg/signalatlas

# 5. CROSS-PLATFORM SOCIAL HANDLES FOR PROFILE MENTIONS
FARCASTER_HANDLE=@signal-atlas

