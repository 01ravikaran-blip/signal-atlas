{
  "name": "signal-atlas-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "cron:run": "tsx src/cronRunner.ts",
    "healthcheck": "node -e \"import('axios').then(a => a.default.get('http://127.0.0.1:' + (process.env.PORT || '5050') + '/health/readiness').then(r => console.log(JSON.stringify(r.data, null, 2))))\"",
    "production:smoke-test": "tsx src/scripts/smokeTest.ts",
    "test": "tsx tests/runner.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.13.15",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "rss-parser": "^3.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
